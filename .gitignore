.DS_Store

# Built locally from pictures that are not ours to publish: build.swift downloads
# them, checks their SHA-256 and draws the font on the user's machine.
fonts/svg/
*.otf

# The private half of the project lives in a sibling repository and is
# attached by a symlink. No trailing slash on purpose: `.local/` does not
# match a symlink, git would start tracking it, and the link would end up in
# the public repository dangling for everyone who clones it.
.local
CLAUDE.md
